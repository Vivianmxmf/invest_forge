# InvestForge environment variables — copy to `.env` and fill in real values.
# `.env` is git-ignored.

# === LLM providers (at least one must be set on the server) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# === Dataset distillation (Week-2 SFT pipeline) ===
# Provider for the "teacher" LLM used by scripts/build_sft_dataset.py.
# Options:
#   openai      — cloud, needs TEACHER_OPENAI_API_KEY (best quality)
#   anthropic   — cloud, needs TEACHER_ANTHROPIC_API_KEY
#   hf          — in-process HuggingFace model, NO API KEY required;
#                 runs on one of the GPU server cards.  Recommended:
#                 TEACHER_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#                 Note: teacher should ideally be >= student in capability;
#                 <8B self-distillation is useful for format alignment but
#                 a larger cloud model yields richer reasoning traces.
#   local       — vLLM OpenAI-compatible endpoint (see LOCAL_LLM_BASE_URL)
#   fake        — offline/test mode (no real LLM)
TEACHER_LLM_PROVIDER=openai
# Teacher model name. If unset, defaults to a strong model per provider
# (openai=gpt-4o, anthropic=claude-sonnet-4-5, hf=Qwen/Qwen2.5-7B-Instruct).
# Never falls back to fake-llm when a real provider is selected.
TEACHER_LLM_MODEL=
# Key for the teacher provider — only needed for openai/anthropic teachers.
# For hf (in-process) no key is required.
TEACHER_OPENAI_API_KEY=
TEACHER_ANTHROPIC_API_KEY=

# Optional: local vLLM endpoint (running on the A5000 server)
LOCAL_LLM_BASE_URL=
# Base model name as registered with vLLM (e.g. Qwen/Qwen2.5-7B-Instruct).
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LoRA adapter name registered with vLLM via --lora-modules.
# Only the analyst node uses this; researcher + risk-control keep the base model.
# Leave blank to route all nodes through the base model.
LOCAL_ANALYST_MODEL=investforge-analyst

# === Vision VLM — multimodal report/chart image analysis (server-only) ===
# Set LOCAL_VISION_MODEL to activate the vision node.  When unset the vision
# node is a complete no-op and the pipeline behaves exactly as before.
# The vision VLM runs at a SEPARATE vLLM endpoint (docker-compose vllm-vision
# service, default port 8002) so it does not interfere with the text LLM.
LOCAL_VISION_BASE_URL=http://localhost:8002/v1
LOCAL_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Host port for the vision vLLM container (docker-compose vllm-vision service).
VLLM_VISION_PORT=8002

# === Image input policy (vision security) ===
# Maximum number of images allowed per /analyze request.
VISION_MAX_IMAGES=4
# Per-image byte limit (default 8 MB).
VISION_MAX_BYTES=8000000
# Maximum width×height pixel count — decompression-bomb guard (default 24 MP).
VISION_MAX_PIXELS=24000000
# SAFE DEFAULT: local file paths are DISABLED.  Set to true only in trusted
# environments where the upload directory is strictly controlled.
VISION_ALLOW_LOCAL_PATHS=false
# Directory that local image paths must resolve inside (only relevant when
# VISION_ALLOW_LOCAL_PATHS=true).
VISION_UPLOAD_DIR=
# Optional comma-separated allowlist of permitted image URL hostnames (e.g.
# storage.example.com,cdn.example.com).  Empty = any PUBLIC https host.
VISION_URL_ALLOWLIST=
# HTTP fetch timeout in seconds for URL-sourced images.
VISION_FETCH_TIMEOUT=5.0

# === HuggingFace in-process provider (LLM_PROVIDER=hf or TEACHER_LLM_PROVIDER=hf) ===
# device_map passed to AutoModelForCausalLM.from_pretrained.
# "auto" lets accelerate distribute across available GPUs.
HF_DEVICE=auto
# Dtype for the model: "auto" | "bf16" | "fp16" | "fp32"
# "auto" lets transformers pick the best dtype for the hardware.
HF_DTYPE=auto

# === LoRA adapter paths (server-side, docker-compose volumes) ===
# Host directory containing adapter subdirs (e.g. ./models/adapters).
# Mounted into vLLM container at /adapters.
LORA_ADAPTERS_DIR=./models/adapters
# Path inside the vLLM container where the analyst adapter lives.
LORA_ADAPTER_PATH=/adapters/investforge-analyst

# Default routing.  "fake" lets the whole pipeline run offline (used by tests
# and laptop dev).  Switch to "openai" / "anthropic" / "local" on the server.
LLM_PROVIDER=fake
LLM_MODEL=fake-llm

# === Market data providers ===
TUSHARE_TOKEN=
AKSHARE_DISABLE_LOG=1

# === Vector store ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=invest_forge_kb

# === Embeddings + reranker ===
# Tip: keep the multilingual BGE family for A-share documents.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# === LangGraph runtime (server-only) ===
# Set to true on the server to run the real LangGraph compiled runtime instead
# of the in-process inline runner.  When true, LangSmith tracing captures every
# node transition (requires LANGCHAIN_TRACING_V2=true and LANGCHAIN_API_KEY set).
# Default false — the whole pipeline runs offline without langgraph installed.
USE_LANGGRAPH=false

# === LangSmith (optional observability) ===
# Tracing only captures agent graph node transitions when USE_LANGGRAPH=true
# (the compiled LangGraph runtime is a LangChain Runnable; the inline runner is not).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=invest_forge

# === Paths ===
DATA_ROOT=./data
RAW_DIR=./data/raw
PDF_DIR=./data/pdfs
KB_DIR=./data/kb
SAMPLE_DIR=./data/sample

# === Server defaults ===
API_HOST=0.0.0.0
API_PORT=8001
DASHBOARD_PORT=8501
LOG_LEVEL=INFO
