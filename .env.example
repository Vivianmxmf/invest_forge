# InvestForge environment variables — copy to `.env` and fill in real values.
# `.env` is git-ignored.

# === LLM providers (at least one must be set on the server) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: local vLLM endpoint (running on the A5000 server)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Default routing.  "fake" lets the whole pipeline run offline (used by tests
# and laptop dev).  Switch to "openai" / "anthropic" / "local" on the server.
LLM_PROVIDER=fake
LLM_MODEL=fake-llm

# === Market data providers ===
TUSHARE_TOKEN=
AKSHARE_DISABLE_LOG=1

# === Vector store ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=invest_forge_kb

# === Embeddings + reranker ===
# Tip: keep the multilingual BGE family for A-share documents.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# === LangSmith (optional observability) ===
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=invest_forge

# === Paths ===
DATA_ROOT=./data
RAW_DIR=./data/raw
PDF_DIR=./data/pdfs
KB_DIR=./data/kb
SAMPLE_DIR=./data/sample

# === Server defaults ===
API_HOST=0.0.0.0
API_PORT=8001
DASHBOARD_PORT=8501
LOG_LEVEL=INFO
